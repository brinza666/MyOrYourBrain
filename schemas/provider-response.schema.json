{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/brinza666/MyOrYourBrain/schemas/provider-response.schema.json",
  "title": "MyOrYourBrain provider response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approach_id",
    "summary",
    "claims",
    "risks",
    "contradictions",
    "questions",
    "recommendation",
    "self_confidence",
    "actions",
    "needs"
  ],
  "properties": {
    "approach_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "summary": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": ["id", "text", "evidence_ids", "criterion_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "criterion_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "risks": {"type": "array", "items": {"type": "string"}},
    "contradictions": {"type": "array", "items": {"type": "string"}},
    "questions": {"type": "array", "items": {"type": "string"}},
    "recommendation": {"enum": ["approve", "revise", "reject", "defer"]},
    "self_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Recorded for diagnostics only; excluded from readiness scoring."
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "description"],
        "properties": {
          "kind": {"enum": ["research", "propose_note", "request_approval", "run_check"]},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "connections", "knowledge", "optional"],
      "properties": {
        "skills": {"type": "array", "items": {"type": "string"}},
        "connections": {"type": "array", "items": {"type": "string"}},
        "knowledge": {"type": "array", "items": {"type": "string"}},
        "optional": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
